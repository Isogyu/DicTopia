NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=

# 本番では必ず https://<ドメイン> を設定してください。
# 未設定の場合は VERCEL_URL → 既定の本番ドメインの順にフォールバックします。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 週替わりお題機能の ON/OFF
NEXT_PUBLIC_FEATURE_WEEKLY_TOPIC=false

# OpenAI モデレーションを無効化する。
# 開発時のみ true にしてください。
# 本番で true にすると、投稿されたテキストが無検査で公開されます。
SKIP_MODERATION=false

# 書き込み系 API のレートリミットを無効化する（ローカル検証用）
DISABLE_RATE_LIMIT=false
